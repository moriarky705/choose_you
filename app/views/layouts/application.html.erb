<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Choose You" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- ファビコン設定 -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">

  <%# Tailwind CSS CDN for styling %>
  <script src="https://cdn.tailwindcss.com"></script>
  <%# Direct static asset serving for esbuild output %>
  <script src="/assets/application.js" defer></script>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4">
      <% flash.each do |type, msg| %>
        <div data-controller="flash" data-flash-auto-dismiss-value="<%= type.to_s == 'alert' ? 'false' : 'true' %>" role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>" class="mb-4 p-3 rounded text-sm flex items-start justify-between gap-3 <%= type.to_s == 'alert' ? 'bg-red-100 text-red-800 border border-red-200' : 'bg-green-100 text-green-800 border border-green-200' %>">
          <span><%= msg %></span>
          <button type="button" data-action="click->flash#dismiss" class="shrink-0 opacity-60 hover:opacity-100" aria-label="閉じる">×</button>
        </div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
