<% content_for :title, "Choose You - ルーム #{@room.id}" %>
<div class="min-h-screen bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 py-6" data-controller="room" data-room-room-id-value="<%= @room.id %>" data-room-owner-value="<%= @owner_view %>" data-room-self-id-value="<%= @self_id %>" data-room-owner-id-value="<%= @room.owner_id %>">
    <!-- Material Design Header Card -->
    <div class="bg-white rounded-lg shadow-md mb-6 overflow-hidden">
      <div class="bg-indigo-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-medium text-white mb-1">ルーム <span class="font-mono tracking-widest"><%= @room.id %></span></h1>
            <p class="text-indigo-100 flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
              </svg>
              <span><%= @owner_view ? @room.owner_name : (@participant&.name || '不明') %></span>
            </p>
          </div>
          <div class="text-right">
            <div class="inline-flex items-center bg-white/20 backdrop-blur-sm text-white px-3 py-1 rounded-full text-sm">
              <div class="w-2 h-2 bg-green-400 rounded-full mr-2"></div>
              <%= @owner_view ? 'オーナー' : 'ゲスト' %>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% if @owner_view %>
    <!-- Material Design Control Panel -->
    <div class="bg-white rounded-lg shadow-md mb-6 overflow-hidden">
      <div class="p-6">
        <h2 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
          <svg class="w-5 h-5 text-indigo-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
          参加リンク
        </h2>
        
        <div class="bg-gray-50 border border-gray-200 rounded p-4 mb-6">
          <div class="flex flex-wrap items-center gap-3">
            <code data-room-target="inviteUrl" class="min-w-0 w-full sm:w-auto sm:flex-1 bg-white border border-gray-300 px-3 py-2 rounded text-sm text-gray-700 break-all"><%= room_url(@room.id) %></code>
            <button type="button" data-action="click->room#copyInvite" data-room-target="copyButton"
                    class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded shadow-sm transition-colors duration-200 flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              コピー
            </button>
            <button type="button" data-room-target="shareButton" data-action="click->room#shareInvite"
                    class="hidden bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 px-4 py-2 rounded shadow-sm transition-colors duration-200 flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
              </svg>
              共有
            </button>
            <button type="button" data-action="click->room#toggleQr" aria-expanded="false"
                    class="bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 px-4 py-2 rounded shadow-sm transition-colors duration-200 flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h6v6H4V4zm0 10h6v6H4v-6zm10-10h6v6h-6V4zm2 12h2v2h-2v-2zm-2 2h2v2h-2v-2zm4 0h2v2h-2v-2zm0-4h2v2h-2v-2z"></path>
              </svg>
              QRコード
            </button>
            <span data-room-target="copyFeedback" class="text-sm font-medium" style="display:none;"></span>
          </div>
          <div data-room-target="qrPanel" class="hidden mt-4 flex flex-col items-center gap-2">
            <canvas data-room-target="qrCanvas"></canvas>
            <p class="text-xs text-gray-500">スマートフォンのカメラで読み取って参加できます</p>
          </div>
        </div>

        <h2 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
          <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
          </svg>
          抽選設定
        </h2>
        
        <%= form_with url: select_room_path(@room.id), method: :post, local: true, class: 'flex flex-wrap items-end gap-4',
            data: { action: 'submit->room#startSelection', room_target: 'selectionForm' } do %>
          <div class="flex-1 min-w-0">
            <label class="block text-sm font-medium text-gray-700 mb-1">抽選人数</label>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" data-action="click->room#stepCount" data-step="-1"
                      class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded text-gray-700 hover:bg-gray-50">−</button>
              <%= number_field_tag :count, @last_count, min: 1, max: @participants.size,
                  data: { room_target: 'countInput' },
                  class: 'w-20 border border-gray-300 rounded px-3 py-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500' %>
              <button type="button" data-action="click->room#stepCount" data-step="1"
                      class="w-9 h-9 flex items-center justify-center border border-gray-300 rounded text-gray-700 hover:bg-gray-50">＋</button>
              <button type="button" data-action="click->room#preset" data-preset="one"
                      class="px-2 py-1 text-xs border border-gray-300 rounded text-gray-600 hover:bg-gray-50">1人</button>
              <button type="button" data-action="click->room#preset" data-preset="half"
                      class="px-2 py-1 text-xs border border-gray-300 rounded text-gray-600 hover:bg-gray-50">半分</button>
              <button type="button" data-action="click->room#preset" data-preset="all"
                      class="px-2 py-1 text-xs border border-gray-300 rounded text-gray-600 hover:bg-gray-50">全員</button>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-4">
              <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <%= hidden_field_tag :include_owner, '0', id: nil %>
                <%= check_box_tag :include_owner, '1', true,
                    data: { action: 'change->room#updateEligible' },
                    class: 'rounded border-gray-300 text-indigo-600 focus:ring-indigo-500' %>
                自分（オーナー）も抽選に含める
              </label>
              <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <%= check_box_tag :exclude_winners, '1', false,
                    data: { action: 'change->room#updateEligible' },
                    class: 'rounded border-gray-300 text-indigo-600 focus:ring-indigo-500' %>
                これまでの当選者を除外する
              </label>
            </div>

            <p data-room-target="eligibleHint" class="text-xs text-gray-500 mt-2">抽選対象: <%= @participants.size %>人</p>
          </div>
          <div class="flex items-center gap-3">
            <span data-room-target="selectionStatus" class="hidden items-center text-sm text-gray-600" role="status" aria-live="polite">
              <svg class="w-4 h-4 mr-1 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
              </svg>
              抽選中…
            </span>
            <%= submit_tag '抽選開始', data: { room_target: 'selectionSubmit' },
                class: 'bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded shadow-sm transition-colors duration-200 font-medium' %>
          </div>
        <% end %>
        <p data-room-target="selectionError" class="hidden mt-2 text-sm text-red-600"></p>
      </div>
    </div>
  <% end %>

  <!-- Material Design Main Content -->
  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Participants Card -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-blue-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-medium text-white flex items-center">
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"></path>
            </svg>
            参加者
            <span data-room-target="participantCount" class="bg-white/20 text-white px-2 py-1 rounded ml-2 text-sm"><%= @participants.size %></span>
          </h2>
          <button type="button" data-action="click->room#refreshUpdates" 
                  class="bg-white/20 hover:bg-white/30 text-white px-3 py-1 rounded transition-colors duration-200 flex items-center text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            更新
          </button>
        </div>
      </div>
      <div class="p-6">
        <div data-room-target="participants" class="space-y-3 min-h-[200px]">
          <% @participants.each_with_index do |p, index| %>
            <% is_self = p.id.present? && p.id == @self_id %>
            <div class="flex items-center p-3 <%= is_self ? 'bg-blue-50 hover:bg-blue-100' : 'bg-gray-50 hover:bg-gray-100' %> rounded-lg transition-colors" data-participant-id="<%= p.id %>" data-participant-name="<%= p.name %>">
              <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center text-white font-medium mr-3">
                <%= index + 1 %>
              </div>
              <span class="text-gray-900 font-medium"><%= p.name %></span>
              <% if is_self %>
                <span class="ml-2 text-xs text-blue-600 font-medium">（あなた）</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Selection Results Card -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="bg-amber-600 px-6 py-4" data-room-target="selectionHeader" <%= 'hidden' unless @last_selection %>>
        <h2 class="text-lg font-medium text-white flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
          <span>抽選結果</span>
          <span data-room-target="selectionCount" class="ml-2 text-sm text-amber-100">
            当選者 <%= @last_selection&.dig(:selected)&.size || 0 %>名
          </span>
        </h2>
      </div>
      <div class="p-6" role="status" aria-live="polite">
        <% self_selected = @self_id.present? && @last_selection && @last_selection[:selected]&.any? { |s| s[:id].present? && s[:id] == @self_id } %>
        <div data-room-target="selfResult" class="mb-4 p-3 rounded-lg text-center font-medium <%= 'hidden' unless @self_id.present? && @last_selection %> <%= self_selected ? 'bg-amber-100 text-amber-800' : 'bg-gray-100 text-gray-600' %>">
          <% if @self_id.present? && @last_selection %>
            <%= self_selected ? '🎉 あなたが選ばれました！' : '今回は選ばれませんでした' %>
          <% end %>
        </div>
        <div data-room-target="roulette" class="hidden text-3xl font-bold text-amber-600 py-10 text-center" aria-hidden="true"></div>
        <div data-room-target="selectionList" class="space-y-3 min-h-[200px]" data-selection-id="<%= @last_selection&.dig(:id) %>">
          <% if @last_selection && @last_selection[:selected]&.any? %>
            <% @last_selection[:selected].each_with_index do |s, index| %>
              <% is_self = s[:id].present? && s[:id] == @self_id %>
              <div class="flex items-center p-4 bg-amber-50 border border-amber-200 rounded-lg <%= 'ring-2 ring-amber-400' if is_self %>" data-selection-result data-selection-name="<%= s[:name] %>">
                <div class="w-10 h-10 bg-amber-600 rounded-full flex items-center justify-center text-white font-bold mr-3">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                  </svg>
                </div>
                <span class="text-gray-900 font-semibold"><%= s[:name] %></span>
                <% if is_self %>
                  <span class="ml-2 text-xs text-amber-700 font-medium">（あなた）</span>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
        <div data-room-target="selectionEmpty" class="flex flex-col items-center justify-center py-12 text-gray-500 <%= 'hidden' if @last_selection %>">
          <svg class="w-12 h-12 mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
          </svg>
          <p class="text-center">抽選結果がここに表示されます</p>
        </div>
      </div>
    </div>
  </div>

  <!-- History Card -->
  <div class="bg-white rounded-lg shadow-md overflow-hidden mt-6 <%= 'hidden' if @history.blank? %>" data-room-target="historyCard">
    <div class="bg-gray-700 px-6 py-4">
      <h2 class="text-lg font-medium text-white flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        抽選履歴
      </h2>
    </div>
    <div class="p-6">
      <ol data-room-target="historyList" class="space-y-2 text-sm text-gray-700">
        <% @history.each do |entry| %>
          <li>
            <span class="font-medium">第<%= entry[:number] %>回</span>：
            <%= safe_join(entry[:selected].map { |s|
                  s[:id].present? && s[:id] == @self_id ? content_tag(:strong, s[:name]) : s[:name]
                }, '、') %>
          </li>
        <% end %>
      </ol>
      <script type="application/json" data-room-target="historyData"><%= raw json_escape(ActionCableBroadcastService.compact_history(@history).to_json) %></script>
    </div>
  </div>

  <!-- 過去の直前抽選結果表示は仕様変更により削除 -->
</div>
</div>
