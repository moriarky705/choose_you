<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="max-w-md w-full space-y-6">
    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <!-- Material Design Header -->
      <div class="bg-indigo-600 px-6 py-8 text-center">
        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-medium text-white mb-2">部屋を作成</h1>
        <p class="text-indigo-100">新しい抽選ルームを作成します</p>
      </div>

      <!-- Form Content -->
      <div class="p-6">
        <%= form_with url: rooms_path, method: :post, local: true, class: 'space-y-6',
            data: { controller: 'name-form', action: 'submit->name-form#remember' } do |f| %>
          <div>
            <%= label_tag :owner_name, 'オーナー名', class: 'block text-sm font-medium text-gray-700 mb-2' %>
            <%= text_field_tag :owner_name, '',
                placeholder: 'あなたの名前を入力',
                autofocus: true,
                maxlength: 20,
                autocomplete: 'nickname',
                class: 'w-full px-3 py-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors',
                required: true,
                data: { name_form_target: 'input', action: 'input->name-form#check' } %>
            <p data-name-form-target="warning" class="hidden mt-2 text-sm text-amber-600"></p>
          </div>

          <%= submit_tag '部屋を作る',
              class: 'w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded shadow-sm transition-colors duration-200' %>
        <% end %>

        <div class="mt-6 pt-6 border-t border-gray-200">
          <p class="text-xs text-gray-500 text-center">
            部屋を作成すると、参加者を招待できるリンクが生成されます
          </p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="bg-green-600 px-6 py-6 text-center">
        <h2 class="text-xl font-medium text-white">ルームコードで参加</h2>
        <p class="text-green-100 text-sm mt-1">6桁のコードを入力してルームに参加します</p>
      </div>

      <div class="p-6">
        <%= form_with url: find_room_path, method: :get, local: true, class: 'space-y-6' do %>
          <div>
            <%= label_tag :code, 'ルームコード', class: 'block text-sm font-medium text-gray-700 mb-2' %>
            <%= text_field_tag :code, '',
                placeholder: '例: ab12cd',
                maxlength: 6,
                autocomplete: 'off',
                autocapitalize: 'none',
                pattern: '[A-Za-z0-9]{6}',
                inputmode: 'text',
                class: 'w-full px-3 py-3 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-colors',
                required: true %>
          </div>

          <%= submit_tag '参加する',
              class: 'w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded shadow-sm transition-colors duration-200' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
